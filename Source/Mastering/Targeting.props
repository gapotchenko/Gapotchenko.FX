<Project>

  <PropertyGroup Condition=" '$(MasteringProjectKind)' == 'module' OR '$(MasteringProjectKind)' == 'profile' ">
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition=" '$(PublishAot)' != 'true' ">$(TargetFrameworks);netstandard2.0;netstandard2.1;net472</TargetFrameworks>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(MasteringProjectKind)' == 'test' ">
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition=" '$(PublishAot)' != 'true' ">$(TargetFrameworks);net481</TargetFrameworks>
  </PropertyGroup>

  <!-- ================================================================== -->

  <PropertyGroup>
    <MasteringFrameworkIdentifier>$([MSBuild]::GetTargetFrameworkIdentifier($(TargetFramework)))</MasteringFrameworkIdentifier>
    <MasteringFrameworkVersion>$([MSBuild]::GetTargetFrameworkVersion($(TargetFramework)))</MasteringFrameworkVersion>
  </PropertyGroup>

  <Import Project="TargetFrameworkFeatures.props" />

</Project>
